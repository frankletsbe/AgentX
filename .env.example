# Example environment variables for the AI Development Team

# Choose your inference provider: "abacus" or "huggingface"
INFERENCE_PROVIDER=abacus

# For Abacus provider
ABACUS_API_KEY=your_abacus_api_key_here

# For Hugging Face provider
HF_TOKEN=your_huggingface_token_here

# Model settings (optional - will use defaults if not set)
AI_MODEL_NAME=Qwen/Qwen3-72B-Instruct-AWQ
PLANNING_MODEL_NAME=Qwen/Qwen3-72B-Instruct-AWQ